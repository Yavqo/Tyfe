// Rust-style macros and format strings.

fn main() {
    let name = "Tyfe";
    let version = 3;
    let pi = 3.14159265;

    println!("Hello from {name} v{version}!");            // inline variables
    println!("{} + {} = {}", 2, 2, 2 + 2);               // positional
    println!("{0} {1} {0}", "tick", "tock");             // numbered
    println!("{:?} vs {}", "quoted", "plain");          // debug vs display

    println!("[{:8}] [{:<8}] [{:^8}] [{:>8}]", "a", "b", "c", "d");
    println!("[{:*^11}] [{:08.3}] [{:+}]", "center", pi, 42);
    println!("{:.2} {:.0} {:e}", pi, pi, 1500000.0);
    println!("hex {:x} {:#X}, binary {:#b}, octal {:o}", 255, 255, 10, 8);

    let table = [("apples", 3, 0.5), ("kiwis", 12, 0.25), ("melons", 1, 3.0)];
    println!("{:<8}|{:>4}|{:>7}", "fruit", "qty", "price");
    for (fruit, qty, price) in table {
        println!("{fruit:<8}|{qty:>4}|{price:>7.2}");
    }

    let msg = format!("{}-{:03}", "id", 7);
    assert_eq!(msg, "id-007");
    assert!(msg.len() == 6, "unexpected length {}", msg.len());
    let v = vec![1, 2, 3];
    let squares: Vec<i64> = v.iter().map(|x| x * x).collect();
    println!("{:?} -> {:?}", v, squares);
    eprintln!("(this line goes to stderr)");
}
